PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# RN19: bloqueio temporário após N falhas consecutivas de login
LOGIN_MAX_ATTEMPTS=3
LOGIN_BLOCK_MINUTES=15

# PostgreSQL via Drizzle ORM (node-postgres) com Row-Level Security.
# DATABASE_URL: role da API (sem superuser/BYPASSRLS) — criado/atualizado no boot.
# DATABASE_ADMIN_URL: dono das tabelas; usado só no boot (DDL, policies, grants, seed).
DATABASE_URL=postgres://agrostand_app:troque_esta_senha@localhost:5432/agrostand
DATABASE_ADMIN_URL=postgres://postgres:senha_do_admin@localhost:5432/agrostand

# SMTP Configuration for Password Recovery
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@agrostand.com

# Login com Google (Google Identity Services) — console.cloud.google.com > APIs e serviços > Credenciais
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Marketplace (ambiente de teste)
# Geocodificação de endereços para "perto de mim" e mapa (Nominatim/OpenStreetMap, 1 req/s)
GEOCODER=nominatim
# E-mails com acesso de administrador (verificação de produtores e mediação), separados por vírgula
ADMIN_EMAILS=admin.demo@agrostand.com
# URL pública do front (links em e-mails e na prévia de compartilhamento)
FRONTEND_URL=http://localhost:5173
# Envia também por e-mail as notificações do site (on/off). Sem SMTP, usa Ethereal ou o console.
NOTIFY_EMAIL=on
